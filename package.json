{
  "name": "jarvis-assistant",
  "version": "1.0.0",
  "author": "adolseprz13-prog",
  "description": "J.A.R.V.I.S. - Asistente Virtual de Escritorio estilo Iron Man con Tareas, Proyectos, Voz y Google Workspace",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "start": "npm run build && electron ."
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "J.A.R.V.I.S.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/jarvis-coffee-mascot.ico",
      "artifactName": "JARVIS-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "J.A.R.V.I.S."
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@google/genai": "^1.0.0",
    "googleapis": "^148.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
